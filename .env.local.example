# ============================================================
# VSG Tech Solutions — Next.js environment variables
# Copy this file to `.env.local` (git-ignored) and fill in.
# ============================================================

# --- Pilot lead email delivery (Resend) ---------------------
# The /pilot form posts via a server action that emails Stephan.
# If RESEND_API_KEY is missing, submissions are still accepted
# and logged to the server console (visible in `npm run dev`
# output or your hosting provider's logs) — nothing is lost.
#
# To enable real email delivery:
#   1. Sign up at https://resend.com (free tier: 100 emails/day)
#   2. Generate an API key (Dashboard → API Keys → Create)
#   3. Paste it below and restart the dev server
#
# Until you verify your own domain on Resend, the FROM address
# must stay as `onboarding@resend.dev` — Resend only lets that
# sender deliver to the email on your Resend account (that's
# fine for this form since Stephan is always the recipient).
#
# After verifying vsgtech.co.za in Resend, set
# PILOT_FROM_ADDRESS to e.g. "VSG Pilot Form <pilot@vsgtech.co.za>"
# and you can deliver to any address.

RESEND_API_KEY=

# --- Optional per-form overrides ----------------------------
# All three forms (pilot, services, contact) share the same Resend key.
# Each form falls back through its own pair of env vars, then the next
# form's, then to stephan@vsgtech.co.za. Set these only if you want a
# specific form's leads going to a different inbox.

# PILOT_TO_ADDRESS=stephan@vsgtech.co.za
# PILOT_FROM_ADDRESS=VSG Pilot Form <onboarding@resend.dev>

# SERVICES_TO_ADDRESS=stephan@vsgtech.co.za
# SERVICES_FROM_ADDRESS=VSG Services Form <onboarding@resend.dev>

# CONTACT_TO_ADDRESS=stephan@vsgtech.co.za
# CONTACT_FROM_ADDRESS=VSG Contact Form <onboarding@resend.dev>
